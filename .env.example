# MFS OAuth2 client credentials. Each environment has its own client id/secret
# (unlike legacy Mesh, where one client id is shared across both).

# Production (default environment) — https://api.meshpay.com
MFS_CLIENT_ID=your-client-id
MFS_CLIENT_SECRET=your-client-secret

# Sandbox (used when the environment switcher is set to "Sandbox") — https://api.sbx.meshpay.com
MFS_SANDBOX_CLIENT_ID=your-sandbox-client-id
MFS_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret
